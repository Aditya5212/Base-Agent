# ==============================================================================
# Base Agent Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Base Agent"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database (PostgreSQL with psycopg3 driver or standard postgresql://)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/base_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Authentication (Clerk)
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_FRONTEND_API_URL=your-clerk-domain.clerk.accounts.dev

# ==============================================================================
# LLM / Model Provider Configuration (DeepSeek)
# ==============================================================================
# DeepSeek API Key from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Base URLs:
#   OpenAI Format (Default): https://api.deepseek.com
#   Anthropic Format:        https://api.deepseek.com/anthropic
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model Selection (API Model Names):
#   - deepseek-flash  (Version: DeepSeek-V4.1-Flash-1017 | Default/Base)
#     Context: 1M | Max Output: 384K | Vision: Yes | Concurrency: 2500
#   - deepseek-v4-pro (Version: DeepSeek-V4-Pro-0813     | Advanced Reasoning)
#     Context: 1M | Max Output: 384K | Vision: No  | Concurrency: 500
DEEPSEEK_MODEL=deepseek-flash

DEFAULT_TEMPERATURE=0.0

# Optional fallback provider
OPENAI_API_KEY=

# Object Storage (Cloudflare R2 - S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
# Optional custom endpoint override (normally derived from R2_ACCOUNT_ID)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional public base URL if serving files via custom domain / public bucket
# R2_PUBLIC_BASE_URL=https://files.example.com
